{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/hr/layout,_N_T_/(app)/hr/page,_N_T_/hr"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/hr/__PAGE__",
    "/!KGFwcCk/hr",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}