{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/recommendations/layout,_N_T_/(app)/recommendations/page,_N_T_/recommendations"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/recommendations/__PAGE__",
    "/!KGFwcCk/recommendations",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}