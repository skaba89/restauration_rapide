{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/subscriptions/layout,_N_T_/(app)/subscriptions/page,_N_T_/subscriptions"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/subscriptions/__PAGE__",
    "/!KGFwcCk/subscriptions",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}