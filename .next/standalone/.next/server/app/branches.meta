{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/branches/layout,_N_T_/(app)/branches/page,_N_T_/branches"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/branches/__PAGE__",
    "/!KGFwcCk/branches",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}