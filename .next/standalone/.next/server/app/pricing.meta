{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/pricing/layout,_N_T_/(app)/pricing/page,_N_T_/pricing"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/pricing/__PAGE__",
    "/!KGFwcCk/pricing",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}