{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/tracking/layout,_N_T_/(app)/tracking/page,_N_T_/tracking"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/tracking/__PAGE__",
    "/!KGFwcCk/tracking",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}